#!/usr/bin/env bash
set -Eeuo pipefail

STATE_FILE="${JOBAPPLY_TELEGRAM_FAILURE_ALERT_STATE_FILE:-/run/jobapply/telegram-bot-failure-alerted}"
COOLDOWN_SECONDS="${TELEGRAM_BOT_FAILURE_ALERT_COOLDOWN_SECONDS:-900}"
TOKEN="${TELEGRAM_BOT_TOKEN:-}"
CHAT_ID="${TELEGRAM_DEFAULT_CHAT_ID:-}"
QUEUE_STATUS_FILE="${JOBAPPLY_BACKGROUND_QUEUE_STATUS_FILE:-/var/tmp/jobapply-background-job.status}"

# A production deploy intentionally restarts the Telegram bot near the end of
# the deployment. Do not report that planned interruption as an outage. The
# background-job wrapper writes this status before the deploy command starts
# and removes it when the job finishes, so real failures outside a deploy still
# trigger the normal OnFailure notification.
if [[ -f "$QUEUE_STATUS_FILE" ]]; then
  queue_status="$(head -n 1 "$QUEUE_STATUS_FILE" 2>/dev/null || true)"
  if [[ "$queue_status" == jobapply-deploy\ \(running\)* ]]; then
    echo "Telegram bot failure notification suppressed during active deploy."
    exit 0
  fi
fi

if [[ ! "$COOLDOWN_SECONDS" =~ ^[0-9]+$ ]]; then
  COOLDOWN_SECONDS=900
fi

now="$(date +%s)"
if [[ -f "$STATE_FILE" ]]; then
  last_alert="$(stat -c %Y "$STATE_FILE" 2>/dev/null || echo 0)"
  if (( now - last_alert < COOLDOWN_SECONDS )); then
    exit 0
  fi
fi

touch "$STATE_FILE"

if [[ -z "$TOKEN" || -z "$CHAT_ID" ]]; then
  echo "Telegram bot failure notification skipped: token or chat ID is missing." >&2
  exit 0
fi

curl --fail --silent --show-error \
  --max-time 10 \
  --data-urlencode "chat_id=$CHAT_ID" \
  --data-urlencode "text=⚠️ <b>JobApply Telegram bot is unavailable</b>\n\nThe service has failed and is restarting automatically.\n\nCheck on the server:\n<code>journalctl -u jobapply-telegram-bot.service -n 100 --no-pager</code>" \
  --data-urlencode "parse_mode=HTML" \
  "https://api.telegram.org/bot${TOKEN}/sendMessage" \
  >/dev/null || echo "Telegram bot failure notification delivery failed." >&2
