[Unit]
Description=JobApply queued production deployment
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
WorkingDirectory=/opt/jobapply
EnvironmentFile=/opt/jobapply/.env
Environment=JOBAPPLY_BACKGROUND_QUEUE_WAIT_SECONDS=1800
Environment=JOBAPPLY_DEPLOY_REQUEST_MARKER=/var/lib/jobapply/runtime/deploy.requested
TimeoutStartSec=45min
ExecStart=/usr/local/bin/jobapply-run-background-job.sh jobapply-deploy /usr/local/bin/jobapply-deploy-notify.sh
ExecStopPost=/usr/bin/rm -f /var/lib/jobapply/runtime/deploy.requested
