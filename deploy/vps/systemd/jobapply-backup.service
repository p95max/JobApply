[Unit]
Description=JobApply local PostgreSQL backup
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=jobapply
Group=jobapply
WorkingDirectory=/opt/jobapply
EnvironmentFile=/opt/jobapply/.env
ExecStart=/usr/local/bin/jobapply-backup-db.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
