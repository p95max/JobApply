[Unit]
Description=Sync JobApply PostgreSQL to Neon recovery database
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=jobapply
Group=jobapply
WorkingDirectory=/opt/jobapply
EnvironmentFile=/opt/jobapply/.env
ExecStart=/usr/local/bin/jobapply-sync-db-to-neon.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
