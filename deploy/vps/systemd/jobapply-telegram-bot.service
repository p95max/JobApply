[Unit]
Description=JobApply Telegram Bot
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=jobapply
Group=jobapply
WorkingDirectory=/opt/jobapply
EnvironmentFile=/opt/jobapply/.env
ExecStart=/opt/jobapply/.venv/bin/python manage.py run_telegram_bot
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
# Required so the bot can invoke only the exact NOPASSWD systemctl command
# allowed by deploy/vps/sudoers/jobapply-deploy.
NoNewPrivileges=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target
