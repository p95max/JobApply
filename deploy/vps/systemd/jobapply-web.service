[Unit]
Description=JobApply Django web service
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=jobapply
Group=jobapply
WorkingDirectory=/opt/jobapply
Environment="PATH=/opt/jobapply/.venv/bin"
EnvironmentFile=/opt/jobapply/.env
ExecStart=/opt/jobapply/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 1 --threads 2 --timeout 90 --max-requests 500 --max-requests-jitter 50
Restart=always
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
