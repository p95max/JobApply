DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=jobapply.p95max.dev,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://jobapply.p95max.dev
DJANGO_SITE_DOMAIN=jobapply.p95max.dev
DJANGO_SITE_NAME=JobApply
DJANGO_USE_X_FORWARDED_HOST=1
DJANGO_SECURE_PROXY_SSL_HEADER=1
ALLOWED_ACCOUNT_EMAILS=your-google-account@example.com

# Required before publishing the public legal pages.
LEGAL_PROVIDER_NAME=
LEGAL_PROVIDER_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_PRIVACY_CONTACT_EMAIL=
LEGAL_SUPERVISORY_AUTHORITY=
# Kept in sync with deploy/vps/systemd/journald-jobapply-retention.conf.
LEGAL_LOG_RETENTION=14 Tage

POSTGRES_DB=jobapply
POSTGRES_USER=jobapply
POSTGRES_PASSWORD=replace-local-db-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://jobapply:replace-local-db-password@127.0.0.1:5432/jobapply

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file
GOOGLE_GMAIL_SCOPE=https://www.googleapis.com/auth/gmail.readonly

TURNSTILE_ENABLED=0
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

GMAIL_ASSISTANT_AI_ENABLED=0
GMAIL_ASSISTANT_AUTO_SYNC_ENABLED=1
GMAIL_ASSISTANT_AUTO_SYNC_INTERVAL_SECONDS=900
GMAIL_ASSISTANT_DEV_TOOLS=0
OPENAI_API_KEY=
OPENAI_EMAIL_MODEL=gpt-4.1-mini
# GPT-4.1 mini standard API pricing per 1M tokens (USD).
OPENAI_INPUT_USD_PER_1M=0.40
OPENAI_OUTPUT_USD_PER_1M=1.60

BACKUP_DATABASE_URL=
RCLONE_REMOTE=gdrive:JobApply/database-backups

# Telegram owner-only production deploy. Keep disabled until the unit and sudoers
# files are installed and verified with sudo -n.
TELEGRAM_DEPLOY_ENABLED=0
TELEGRAM_DEPLOY_CONFIRMATION_TTL_SECONDS=300
# A bot outage is reported by systemd at most once per 15 minutes.
TELEGRAM_BOT_FAILURE_ALERT_COOLDOWN_SECONDS=900
JOBAPPLY_PRODUCTION_BRANCH=master
