DJANGO_SECRET_KEY=change-me
# Recommended: a separate, stable secret for encrypted OAuth access/refresh tokens.
OAUTH_TOKEN_ENCRYPTION_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

POSTGRES_DB=jobapply
POSTGRES_USER=jobapply
POSTGRES_PASSWORD=jobapply
POSTGRES_HOST=db
POSTGRES_PORT=5432

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin12345

ADMIN_URL=backoffice
# Staff-only AI audit API. Leave empty to disable it. On production use an
# unguessable single path segment, for example: ai-audit-<random-value>.
AI_AUDIT_URL=
AI_AUDIT_API_MAX_PAGE_SIZE=100

# allauth / google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DJANGO_SITE_DOMAIN=0.0.0.0:8000
DJANGO_SITE_NAME=JobApply
# Set to 1 only when a trusted reverse proxy (for example a Codespaces public
# port) supplies X-Forwarded-Host and X-Forwarded-Proto.
DJANGO_USE_X_FORWARDED_HOST=0
DJANGO_SECURE_PROXY_SSL_HEADER=0

# Temporary demo workspaces and their sessions expire after this many hours.
DEMO_ACCOUNT_TTL_HOURS=12

# Cloudflare Turnstile (anti-bot gate before Google OAuth, anonymous users only)
TURNSTILE_SITE_KEY=0x....
TURNSTILE_SECRET_KEY=0x....
# In prod TURNSTILE_ENABLED=1 dev TURNSTILE_ENABLED=0
TURNSTILE_ENABLED=0

# Gmail Assistant AI (disabled unless explicitly enabled and consented to by the user)
GMAIL_ASSISTANT_AI_ENABLED=0
# Runs Gmail Assistant checks for opted-in users. The interval has a minimum of 60 seconds.
GMAIL_ASSISTANT_AUTO_SYNC_ENABLED=1
GMAIL_ASSISTANT_AUTO_SYNC_INTERVAL_SECONDS=900
PERSONAL_DRIVE_BACKUP_INTERVAL_SECONDS=21600
# Enables destructive Gmail Assistant reset tools for local development only.
GMAIL_ASSISTANT_DEV_TOOLS=0
OPENAI_API_KEY=
OPENAI_EMAIL_MODEL=gpt-5.4-nano
GMAIL_ASSISTANT_AI_DAILY_LIMIT=50
GMAIL_ASSISTANT_AI_CONFIDENCE_THRESHOLD=80
GMAIL_ASSISTANT_RULES_FALLBACK_ENABLED=1

# Telegram Bot (owner-only, disabled by default)
TELEGRAM_BOT_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_OWNER_USER_ID=
TELEGRAM_OWNER_EMAIL=
TELEGRAM_ENV_LABEL=DEVELOPMENT
# Required before publishing the legal pages. Use the same email as the legal contact where applicable.
LEGAL_PROVIDER_NAME=
LEGAL_PROVIDER_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_PRIVACY_CONTACT_EMAIL=
LEGAL_SUPERVISORY_AUTHORITY=
# Kept in sync with deploy/vps/systemd/journald-jobapply-retention.conf.
LEGAL_LOG_RETENTION=14 Tage
TELEGRAM_NOTIFICATIONS_ENABLED=0
# Expiry and per-user rate limit for proposal callback buttons.
TELEGRAM_CALLBACK_TTL_SECONDS=900
TELEGRAM_RATE_LIMIT_COUNT=20
TELEGRAM_RATE_LIMIT_WINDOW_SECONDS=60
# Production deploy is off by default and uses a short-lived callback confirmation.
TELEGRAM_DEPLOY_ENABLED=0
TELEGRAM_DEPLOY_CONFIRMATION_TTL_SECONDS=300
JOBAPPLY_PRODUCTION_BRANCH=master
